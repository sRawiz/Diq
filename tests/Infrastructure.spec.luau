-- INSERT_MOCKS
-- INSERT_MODULES
local Core = factories.Infrastructure()
local scope = Core.CreateScope(task,warn)
local cleaned={}
scope:Add(function() table.insert(cleaned,"first") end)
scope:Add(function() error("cleanup failure") end)
scope:Add(function() table.insert(cleaned,"last") end)
local ran=false
scope:Delay(1,function() ran=true end)
scope:Destroy(); scope:Destroy(); advance(2)
check(not ran and cleaned[1]=="last" and cleaned[2]=="first","LIFO cleanup continues after failures and cancels pending tasks")
local yielding=Core.CreateScope(task,warn)
yielding:Delay(0,function() task.wait(1); ran=true end)
advance(0); yielding:Destroy(); advance(2)
check(not ran,"Scope cancels yielding task, not only pending task")
local properties=Core.CreateProperties()
local object={Value=1}; local a,b={},{}
properties:Set(a,object,"Value",2); properties:Set(b,object,"Value",3); properties:Set(a,object,"Value",4)
check(object.Value==3,"Updating a claim does not steal another owner's priority")
properties:Release(b); check(object.Value==4,"Releasing top owner reapplies remaining claim")
properties:Release(a); check(object.Value==1 and next(properties.objects)==nil,"Last owner restores true baseline")
properties:Set(a,object,"Value",2); object.Value=9; properties:Release(a)
check(object.Value==9,"Cleanup preserves an external change after the final write")
local input=Core.CreateInput(Input,warn)
local received=0
local first=input:Connect("InputBegan",function() error("test") end)
local second=input:Connect("InputBegan",function() received+=1 end)
check(Input.InputBegan:Count()==1,"Input subscribers share one engine connection")
Input.InputBegan:Fire({}); check(received==1,"Failing input callback cannot starve others")
first:Disconnect(); second:Disconnect()
check(Input.InputBegan:Count()==0,"Last subscriber releases engine connection")
input:Destroy()
local scheduler=Core.CreateScheduler(RunService,function() return now end,warn)
local calls=0
local job=scheduler:Connect("test","Heartbeat",0.1,function() calls+=1 end)
for _=1,120 do RunService.Heartbeat:Fire(1/120) end
check(calls>=9 and calls<=10,"Scheduler frequency is independent of frame rate")
RunService.Heartbeat:Fire(2)
check(calls<=11,"Stall does not trigger an unbounded catch-up loop")
job:Disconnect(); check(RunService.Heartbeat:Count()==0,"Idle scheduler disconnects")
local recovered=false
scheduler:Connect("failed","Heartbeat",0,function() error("test") end,function() recovered=true end)
RunService.Heartbeat:Fire(0.01)
check(recovered and RunService.Heartbeat:Count()==0 and scheduler.stats.failed.Failures==1,"Scheduler failure stops work and invokes rollback")
scheduler:Destroy()
local before=liveConnections()
local runtime=Core.new({Players=Players,RunService=RunService,Input=Input,Task=task,Clock=function() return now end,Warn=warn})
local record=runtime.Registry:Get(enemy)
check(record.Root==enemy.Character.HumanoidRootPart and record.Humanoid.Health==100,"Registry seeds existing characters")
local extra=Instance.new("Part"); extra.Parent=enemy.Character
check(record.Parts[extra],"Registry tracks late descendant")
extra.Parent=nil; check(not record.Parts[extra],"Registry removes streamed-out descendant")
local registryConnections=liveConnections()
for i=1,25 do
	local joined=newPlayer("Join"..i,"red"); Players.PlayerAdded:Fire(joined)
	check(runtime.Registry:Get(joined)~=nil,"Registry tracks join")
	Players.PlayerRemoving:Fire(joined); table.remove(Players.list,table.find(Players.list,joined))
	joined.CharacterAdded:Fire(newCharacter())
	check(runtime.Registry:Get(joined)==nil,"Removed player cannot resurrect registry record")
end
check(liveConnections()==registryConnections,"Join/leave churn releases all player and character subscriptions")
local previous=enemy.Character
enemy.CharacterRemoving:Fire(previous); enemy.Character=newCharacter(); enemy.CharacterAdded:Fire(enemy.Character)
check(record.Character==enemy.Character and record.Root==enemy.Character.HumanoidRootPart,"Registry changes generation on respawn")
local movement=factories.MovementSystem({Runtime=runtime,DeferInit=true})
local hitbox=factories.HitboxSystem({Runtime=runtime,DeferInit=true})
movement.Init(); hitbox.Init()
check(RunService.PreSimulation:Count()==0,"Disabled features have no simulation callbacks")
local oldSize=enemy.Character.Head.Size
local descendantCalls=enemy.Character.calls.descendants
local playerCalls=Players.enumerations
movement.SetNoFling(true); hitbox.SetEnabled(true)
RunService.PreSimulation:Fire(1/60)
check(not enemy.Character.Head.CanCollide and enemy.Character.Head.Size==vec(5,5,5),"Features apply shared property claims")
local writes=enemy.Character.Head.writes.Size
for _=1,60 do RunService.PreSimulation:Fire(1/60) end
check(enemy.Character.calls.descendants==descendantCalls and Players.enumerations==playerCalls,"Hot path uses registry without repeated hierarchy/player enumeration")
check(enemy.Character.Head.writes.Size==writes,"Unchanged properties are not rewritten every step")
movement.SetNoFling(false)
check(not enemy.Character.Head.CanCollide,"Disabling one owner preserves other feature's collision claim")
hitbox.SetEnabled(false)
check(enemy.Character.Head.CanCollide and enemy.Character.Head.Size==oldSize,"Final owner restores original size and collision")
hitbox.SetEnabled(true); RunService.PreSimulation:Fire(1/60)
local oldHead=enemy.Character.Head
enemy.CharacterRemoving:Fire(enemy.Character); enemy.Character=newCharacter(); enemy.CharacterAdded:Fire(enemy.Character)
local newHead=enemy.Character.Head; local newSize=newHead.Size
RunService.PreSimulation:Fire(1/60)
check(oldHead.Size==oldSize and newHead.Size==vec(5,5,5),"Respawn restores old instance and snapshots new instance independently")
hitbox.SetEnabled(false); check(newHead.Size==newSize,"Respawn cleanup restores the new baseline")
movement.SetNoClip(true); RunService.PreSimulation:Fire(1/60)
check(not own.Character.Head.CanCollide,"NoClip applies")
movement.SetNoClip(false); check(own.Character.Head.CanCollide,"NoClip restores collision immediately")
movement.SetFly(true); RunService.PreSimulation:Fire(1/60)
check(own.Character:FindFirstChildOfClass("Humanoid").PlatformStand,"Flight applies owned state")
movement.SetFly(false)
check(not own.Character:FindFirstChildOfClass("Humanoid").PlatformStand,"Flight restores PlatformStand")
local state
movement.SetStateListener(function(value) state=value end)
movement.SetSpeed(true); own.CharacterRemoving:Fire(own.Character)
check(state and not state.IsCFrameSpeed and not movement.GetState().IsCFrameSpeed,"Respawn publishes authoritative state")
own.CharacterAdded:Fire(own.Character)
movement.Destroy(); hitbox.Destroy()
check(not movement.SetNoClip(true) and not hitbox.SetEnabled(true),"Destroyed features cannot restart")
local esp=factories.ESPSystem({Runtime=runtime,DeferInit=true})
esp.Init(); esp.SetEnabled(true); RunService.RenderStepped:Fire(1/60)
check(esp.GetMetrics().Projections==0 and esp.GetMetrics().Drawings==0,"Injected ESP retains Highlight-only fast path")
esp.SetNames(true); RunService.RenderStepped:Fire(1/60)
check(esp.GetMetrics().Projections>0 and esp.GetMetrics().Drawings>0,"Injected ESP enables lazy overlay")
esp.Destroy()
local aim=factories.AimbotSystem({Runtime=runtime,DeferInit=true})
aim.Init(); aim.ApplyAssistPreset(); aim.SetEnabled(true)
for _,callback in RunService.bindings do callback(1/60) end
check(aim.GetCurrentTarget()==enemy.Character.Head,"Injected aim reads shared registry and routes input")
aim.Destroy()
local misc=factories.MiscSystem({Runtime=runtime})
local light=Lighting.Brightness
misc.SetFullbright(true); check(Lighting.Brightness==2,"Fullbright applies immediately")
Lighting.Brightness=4; advance(0.1); check(Lighting.Brightness==2,"External lighting changes are coalesced")
misc.SetFullbright(false); check(Lighting.Brightness==light,"Fullbright restores baseline")
misc.SetFullbright(true); Lighting.Brightness=3; misc.Destroy(); advance(0.2)
check(Lighting.Brightness==3,"Pending lighting action cannot overwrite external state after Destroy")
local failed=factories.MiscSystem({Runtime=runtime})
local published
failed.SetStateListener(function(value) published=value end)
check(failed.SetAntiAFK(true),"AntiAFK registers when service exists")
VirtualUser.CaptureController=function() error("permission denied") end
own.Idled:Fire()
check(not failed.IsAntiAFK() and not published.IsAntiAFK and own.Idled:Count()==0,"Runtime permission failure disables feature and publishes state")
failed.Destroy()
runtime:Destroy(); runtime:Destroy()
check(liveConnections()==before and next(RunService.bindings)==nil,"Runtime releases all owned connections")
check(next(runtime.Properties.objects)==nil,"Runtime releases all property claims")
local standalone=factories.MovementSystem()
standalone.SetNoClip(true); RunService.PreSimulation:Fire(1/60); standalone.Destroy()
check(own.Character.Head.CanCollide,"Standalone Movement preserves direct loading and restoration")
local standaloneHitbox=factories.HitboxSystem()
standaloneHitbox.SetEnabled(true); RunService.PreSimulation:Fire(1/60); standaloneHitbox.Destroy()
check(enemy.Character.Head.Size==newSize and enemy.Character.Head.CanCollide,"Standalone Hitbox preserves direct loading and restoration")
check(liveConnections()==before,"Standalone modules leave no connections behind")
print("Infrastructure checks passed: "..checks)
